# Copy this to server/.env.test and point it at a DISPOSABLE Neo4j
# instance — NEVER your production database. `npm test` seeds and
# deletes real graph data as part of the fixture setup/teardown.
#
# All keys below are required — the test suite (test/testEnv.ts) skips
# entirely rather than run if any are missing, specifically so an
# incomplete .env.test can never silently fall through to values from
# your real .env (dotenv never overwrites an already-set variable, so
# once a key is set here it can't be overridden — see test/setup.ts).

# A free AuraDB instance, or a local `docker run neo4j` container, both
# work fine for this — it just needs to be empty/disposable.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Not used for real Google sign-in in tests (they mint JWTs directly via
# issueSessionToken, bypassing OAuth) — any non-empty value satisfies
# isConfigured() so the app's setupGate doesn't block requests.
GOOGLE_CLIENT_ID=test-client-id
JWT_SECRET=any-long-random-test-string
BOOTSTRAP_SUPER_ADMINS=test@example.com
BOOTSTRAP_SUPER_ADMIN_COUNTY=TestCounty
