# Everything below is OPTIONAL. If you'd rather not hand-edit this file,
# leave it all blank, start the server, and open the app — it will show a
# Setup Wizard that collects these same values through a form and saves
# them to server/data/runtime-config.json (gitignored) instead. Whatever
# you set here still works too; the wizard only fills in what's left
# blank, and values saved through it take precedence.

# Neo4j / AuraDB
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Auth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Seed / bootstrap
# Comma-separated emails that are always treated as Super Admin on first login,
# even before a Whitelist node exists for them (bootstrap only).
BOOTSTRAP_SUPER_ADMINS=
BOOTSTRAP_SUPER_ADMIN_COUNTY=Bomi

# SMS/WhatsApp intake (Phase 2 stub, server/src/routes/intake.routes.ts).
# Leave unset to keep /api/intake/* disabled (501). If set, a webhook must
# send it back as the X-Intake-Key header. Not part of the Setup Wizard —
# this is deployment-time config for a bot integration, not a login credential.
INTAKE_API_KEY=
